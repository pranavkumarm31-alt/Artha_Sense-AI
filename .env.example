# Optional MoSPI response-cache configuration (milliseconds; default six hours).
MOSPI_CACHE_TTL_MS=21600000

# Optional historical intelligence service.
# Use the same high-entropy secret in the Next.js app and Python service.
INTELLIGENCE_API_TOKEN=replace-with-a-long-random-secret
INTELLIGENCE_SERVICE_URL=http://127.0.0.1:8000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Configure an OpenAI-compatible provider for semantic search and generated answers.
# Keep these values in the Python service environment; never expose them to the browser.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RESEARCH_INGEST_TOKEN=

# Optional PostgreSQL test URL used only by python-service integration tests.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/TEST_DATABASE
